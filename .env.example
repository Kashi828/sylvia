# Supabase Postgres
# Vercel's Supabase integration provides this variable automatically.
POSTGRES_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres

# Optional Supabase application credentials for future Auth/Realtime features.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MQTT transport
SYLVIA_MQTT_BROKER=mqtt://localhost:1883
SYLVIA_MQTT_USERNAME=
SYLVIA_MQTT_PASSWORD=
SYLVIA_MQTT_CLIENT_ID=sylvia-cloud
SYLVIA_MQTT_TOPIC_PREFIX=sylvia

# Hosted hardware beta
SYLVIA_PUBLIC_BASE_URL=https://your-sylvia-beta.example
SYLVIA_BRIDGE_TOKEN=replace-with-a-long-random-bridge-secret
SYLVIA_MQTT_BRIDGE_CLIENT_ID=sylvia-mqtt-bridge
SYLVIA_MQTT_TLS=true
SYLVIA_MQTT_CA_FILE=/run/secrets/mqtt-ca.pem
SYLVIA_MQTT_CONNECT_TIMEOUT_MS=10000
